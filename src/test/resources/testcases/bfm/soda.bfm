<?xml version="1.0" encoding="UTF-8"?>
<bfm namespace="VendingMachine">
    <feature name="VendingMachine">
        <events>
            <event id="take_0" action="take" fexpression="(VendingMachine &amp;&amp; (Tea || Soda))"> </event>
            <event id="change_0" action="change" fexpression="!FreeDrinks"> </event>
            <event id="free_0" action="free" fexpression="FreeDrinks"> </event>
            <event id="pay_0" action="pay" fexpression="!FreeDrinks"> </event>
            <event id="soda_0" action="soda" fexpression="Soda"> </event>
            <event id="cancel_0" action="cancel" fexpression="CancelPurchase"> </event>
            <event id="take_1" action="take" fexpression="(VendingMachine &amp;&amp; (Tea || Soda) &amp;&amp; !FreeDrinks)"> </event>
            <event id="pour_tea_0" action="pour_tea" fexpression="Tea"> </event>
            <event id="close_0" action="close" fexpression="(VendingMachine &amp;&amp; (Tea || Soda) &amp;&amp; !FreeDrinks)"> </event>
            <event id="tea_0" action="tea" fexpression="Tea"> </event>
            <event id="return_0" action="return" fexpression="CancelPurchase"> </event>
            <event id="pour_soda_0" action="pour_soda" fexpression="Soda"> </event>
            <event id="open_0" action="open" fexpression="((Tea || Soda) &amp;&amp; !FreeDrinks)"> </event>
        </events>
        <mandatory>
            <feature name="Currency">
                <alternative>
                    <feature name="Euro"></feature>
                    <feature name="Dollar"></feature>
                </alternative>
            </feature>
        </mandatory>
        <optional>
            <feature name="FreeDrinks"></feature>
        </optional>
        <mandatory>
            <feature name="Beverages">
                <or>
                    <feature name="Soda"></feature>
                    <feature name="Tea"></feature>
                </or>
            </feature>
        </mandatory>
        <optional>
            <feature name="CancelPurchase"></feature>
        </optional>
        <event_constraints>
            <causalities>
                <causality target="open_0">
                    <bundle>
                        <event id="pour_tea_0"> </event>
                        <event id="pour_soda_0"> </event>
                    </bundle>
                </causality>
                <causality target="take_1">
                    <bundle>
                        <event id="open_0"> </event>
                    </bundle>
                </causality>
                <causality target="pour_tea_0">
                    <bundle>
                        <event id="tea_0"> </event>
                    </bundle>
                </causality>
                <causality target="change_0">
                    <bundle>
                        <event id="pay_0"> </event>
                    </bundle>
                </causality>
                <causality target="close_0">
                    <bundle>
                        <event id="take_1"> </event>
                    </bundle>
                </causality>
                <causality target="soda_0">
                    <bundle>
                        <event id="change_0"> </event>
                        <event id="free_0"> </event>
                    </bundle>
                </causality>
                <causality target="take_0">
                    <bundle>
                        <event id="pour_tea_0"> </event>
                        <event id="pour_soda_0"> </event>
                    </bundle>
                </causality>
                <causality target="pour_soda_0">
                    <bundle>
                        <event id="soda_0"> </event>
                    </bundle>
                </causality>
                <causality target="return_0">
                    <bundle>
                        <event id="cancel_0"> </event>
                    </bundle>
                </causality>
                <causality target="tea_0">
                    <bundle>
                        <event id="change_0"> </event>
                        <event id="free_0"> </event>
                    </bundle>
                </causality>
                <causality target="cancel_0">
                    <bundle>
                        <event id="change_0"> </event>
                        <event id="free_0"> </event>
                    </bundle>
                </causality>
            </causalities>
            <conflicts>
                <conflict>
                    <events>
                        <event id="cancel_0"> </event>
                        <event id="take_1"> </event>
                        <event id="return_0"> </event>
                        <event id="close_0"> </event>
                        <event id="open_0"> </event>
                    </events>
                    <events>
                        <event id="take_0"> </event>
                    </events>
                </conflict>
                <conflict>
                    <events>
                        <event id="soda_0"> </event>
                        <event id="cancel_0"> </event>
                        <event id="return_0"> </event>
                        <event id="pour_soda_0"> </event>
                    </events>
                    <events>
                        <event id="tea_0"> </event>
                        <event id="pour_tea_0"> </event>
                    </events>
                </conflict>
                <conflict>
                    <events>
                        <event id="take_0"> </event>
                        <event id="soda_0"> </event>
                        <event id="tea_0"> </event>
                        <event id="take_1"> </event>
                        <event id="pour_tea_0"> </event>
                        <event id="close_0"> </event>
                        <event id="pour_soda_0"> </event>
                        <event id="open_0"> </event>
                    </events>
                    <events>
                        <event id="cancel_0"> </event>
                        <event id="return_0"> </event>
                    </events>
                </conflict>
                <conflict>
                    <events>
                        <event id="take_0"> </event>
                        <event id="free_0"> </event>
                        <event id="cancel_0"> </event>
                        <event id="return_0"> </event>
                    </events>
                    <events>
                        <event id="take_1"> </event>
                        <event id="close_0"> </event>
                    </events>
                </conflict>
                <conflict>
                    <events>
                        <event id="free_0"> </event>
                    </events>
                    <events>
                        <event id="pay_0"> </event>
                        <event id="change_0"> </event>
                        <event id="take_1"> </event>
                        <event id="close_0"> </event>
                    </events>
                </conflict>
            </conflicts>
        </event_constraints>
    </feature>
</bfm>