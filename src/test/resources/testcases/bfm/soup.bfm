<?xml version="1.0" encoding="UTF-8"?>
<bfm namespace="VendingMachine">
    <feature name="VendingMachine">
        <events>
            <event id="take_0" action="take" fexpression="(VendingMachine &amp;&amp; (TomatoSoup || ChickenSoup || PeaSoup) &amp;&amp; (Euro || Dollar))"> </event>
            <event id="skip_0" action="skip" fexpression="((!Ringtone || !Cup) &amp;&amp; PeaSoup &amp;&amp; (Euro || Dollar))"> </event>
            <event id="pour_tomato_0" action="pour_tomato" fexpression="(TomatoSoup &amp;&amp; (Euro || Dollar))"> </event>
            <event id="insert_dollar_0" action="insert_dollar" fexpression="Dollar"> </event>
            <event id="skip_3" action="skip" fexpression="(TomatoSoup &amp;&amp; (!Ringtone || !Cup) &amp;&amp; (Euro || Dollar))"> </event>
            <event id="bad_luck_0" action="bad_luck" fexpression="(!Cup &amp;&amp; (TomatoSoup || ChickenSoup || PeaSoup) &amp;&amp; (Euro || Dollar))"> </event>
            <event id="pour_chicken_0" action="pour_chicken" fexpression="(ChickenSoup &amp;&amp; (Euro || Dollar))"> </event>
            <event id="cancel_0" action="cancel" fexpression="(CancelPurchase &amp;&amp; (Euro || Dollar))"> </event>
            <event id="skip_1" action="skip" fexpression="((!Ringtone || !Cup) &amp;&amp; ChickenSoup &amp;&amp; (Euro || Dollar))"> </event>
            <event id="ring_0" action="ring" fexpression="(Ringtone &amp;&amp; (TomatoSoup || ChickenSoup || PeaSoup) &amp;&amp; (Euro || Dollar))"> </event>
            <event id="cancel_1" action="cancel" fexpression="(CancelPurchase &amp;&amp; Cup &amp;&amp; (TomatoSoup || ChickenSoup || PeaSoup) &amp;&amp; (Euro || Dollar))"> </event>
            <event id="skip_2" action="skip" fexpression="((!Ringtone || !Cup) &amp;&amp; (TomatoSoup || ChickenSoup || PeaSoup) &amp;&amp; (Euro || Dollar))"> </event>
            <event id="cup_present_2" action="cup_present" fexpression="(TomatoSoup &amp;&amp; Cup &amp;&amp; (Euro || Dollar))"> </event>
            <event id="chicken_0" action="chicken" fexpression="(ChickenSoup &amp;&amp; (Euro || Dollar))"> </event>
            <event id="no_cup_2" action="no_cup" fexpression="(Cup &amp;&amp; PeaSoup &amp;&amp; (Euro || Dollar))"> </event>
            <event id="pour_pea_0" action="pour_pea" fexpression="(PeaSoup &amp;&amp; (Euro || Dollar))"> </event>
            <event id="no_cup_1" action="no_cup" fexpression="(Cup &amp;&amp; ChickenSoup &amp;&amp; (Euro || Dollar))"> </event>
            <event id="no_cup_0" action="no_cup" fexpression="(TomatoSoup &amp;&amp; Cup &amp;&amp; (Euro || Dollar))"> </event>
            <event id="tomato_0" action="tomato" fexpression="(TomatoSoup &amp;&amp; (Euro || Dollar))"> </event>
            <event id="cup_present_1" action="cup_present" fexpression="(Cup &amp;&amp; PeaSoup &amp;&amp; (Euro || Dollar))"> </event>
            <event id="cup_present_0" action="cup_present" fexpression="(Cup &amp;&amp; ChickenSoup &amp;&amp; (Euro || Dollar))"> </event>
            <event id="pea_0" action="pea" fexpression="(PeaSoup &amp;&amp; (Euro || Dollar))"> </event>
            <event id="insert_euro_0" action="insert_euro" fexpression="Euro"> </event>
        </events>
        <mandatory>
            <feature name="Currency">
                <alternative>
                    <feature name="Euro"></feature>
                    <feature name="Dollar"></feature>
                </alternative>
            </feature>
        </mandatory>
        <optional>
            <feature name="Ringtone"></feature>
        </optional>
        <mandatory>
            <feature name="Soup">
                <optional>
                    <feature name="Cup"></feature>
                </optional>
                <mandatory>
                    <feature name="SoupType">
                        <or>
                            <feature name="ChickenSoup"></feature>
                            <feature name="PeaSoup"></feature>
                            <feature name="TomatoSoup"></feature>
                        </or>
                    </feature>
                </mandatory>
            </feature>
        </mandatory>
        <optional>
            <feature name="CancelPurchase"></feature>
        </optional>
        <feature_constraints>
            <feature_constraint fexpression="(Cup || !(Soup &amp;&amp; Dollar))"></feature_constraint>
        </feature_constraints>
        <event_constraints>
            <causalities>
                <causality target="pour_pea_0">
