<bes>
    <events>
        <event id="v||*" action="v"> </event>
        <event id="a||*" action="a"> </event>
        <event id="*||f" action="f"> </event>
        <event id="c||*" action="c"> </event>
        <event id="b||b" action="b"> </event>
        <event id="*||e" action="e"> </event>
    </events>
    <causalities>
        <causality target="*||f">
            <bundle>
                <event id="b||b"> </event>
            </bundle>
        </causality>
        <causality target="c||*">
            <bundle>
                <event id="b||b"> </event>
            </bundle>
        </causality>
        <causality target="b||b">
            <bundle>
                <event id="a||*"> </event>
            </bundle>
            <bundle>
                <event id="*||e"> </event>
            </bundle>
        </causality>
    </causalities>
</bes>