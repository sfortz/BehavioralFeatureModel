            <transition action="ring_bev" target="state11" fexpression="Ringtone"></transition>
            <transition action="skip_bev" target="state11" fexpression="!Ringtone"></transition>
        </state>
        <state id="state2">
            <transition action="pour_sugar" target="state9" fexpression="Beverages"></transition>
