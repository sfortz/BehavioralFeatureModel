<?xml version="1.0" encoding="UTF-8"?>
<bes xmlns:bes="http://www.unamur.be/xml/ts/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<events>
		<event id="map" action="map"/>
		<event id="liDet" action="liDet"/>
		<event id="caDet" action="caDet"/>
		<event id="move_1" action="move"/>
		<event id="move_2" action="move"/>
		<event id="goAround" action="goAround"/>
		<event id="clean" action="clean"/>
		<event id="charge" action="charge"/>
	</events>

	<causalities>
		<causality target="move_1">
			<bundle>
				<event id="map"/>
			</bundle>
		</causality>

		<causality target="liDet">
			<bundle>
				<event id="map"/>
			</bundle>
		</causality>

		<causality target="caDet">
			<bundle>
				<event id="map"/>
			</bundle>
		</causality>

		<causality target="goAround">
			<bundle>
				<event id="liDet"/>
				<event id="caDet"/>
			</bundle>
		</causality>

		<causality target="move_2">
			<bundle>
				<event id="goAround"/>
				<event id="move_1"/>
			</bundle>
		</causality>

		<causality target="clean">
			<bundle>
				<event id="move_2"/>
			</bundle>
		</causality>

		<causality target="charge">
			<bundle>
				<event id="clean"/>
			</bundle>
		</causality>
	</causalities>

	<conflicts>
		<conflict>
			<events>
				<event id="liDet"/>
				<event id="caDet"/>
				<event id="goAround"/>
			</events>
			<events>
				<event id="move_1"/>
			</events>
		</conflict>
		<conflict>
			<events>
				<event id="liDet"/>
			</events>
			<events>
				<event id="caDet"/>
			</events>
		</conflict>
	</conflicts>
</bes>